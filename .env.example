# CampusFix Environment Configuration Example
# Local Mock Mode (Current Phase) - No credentials required.
VITE_APP_NAME=CampusFix
VITE_ENABLE_MOCK_AUTH=true
VITE_MOCK_STORAGE_KEY=campusfix_mock_complaints_v1

# =============================================================
# FUTURE AWS INTEGRATION (Phase 2 - Amazon Cognito, Lambda & DynamoDB)
# Do NOT place real secrets in frontend .env files!
# =============================================================

# Amazon Cognito
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_examplePoolId
VITE_COGNITO_CLIENT_ID=exampleAppClientId12345
VITE_COGNITO_DOMAIN=campusfix-auth.auth.us-east-1.amazoncognito.com

# AWS Lambda Function URLs / Amazon API Gateway
VITE_API_BASE_URL=https://example-function-url.lambda-url.us-east-1.on.aws
VITE_API_TIMEOUT_MS=10000

# Amazon S3 (Future Presigned Upload for Complaint Attachments)
VITE_S3_ATTACHMENT_BUCKET=campusfix-complaint-attachments-prod
