# =============================================================
# CampusFix Environment Configuration
# =============================================================

# Local Mock Mode ('true' = use in-memory demo data, 'false' = use Cognito & AWS)
VITE_APP_NAME=CampusFix
VITE_ENABLE_MOCK_AUTH=true
VITE_MOCK_STORAGE_KEY=campusfix_mock_complaints_v1

# =============================================================
# AMAZON COGNITO USER POOL (ap-southeast-2)
# Flow: Authorization Code Flow with PKCE
# App Client: CampusFix (Public client - Client Secret: NONE)
# =============================================================

# Confirmed AWS Region
VITE_AWS_REGION=ap-southeast-2

# Enter your confirmed Cognito User Pool ID (e.g. ap-southeast-2_XXXXXXXXX)
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX

# Enter your confirmed App Client ID (26-character string from AWS Console)
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Enter your confirmed Cognito Domain prefix or custom domain (without https://)
# Example: your-campusfix-domain.auth.ap-southeast-2.amazoncognito.com
VITE_COGNITO_DOMAIN=your-cognito-domain.auth.ap-southeast-2.amazoncognito.com

# Confirmed Local Redirect URI (must match the Allowed Callback URLs in Cognito App Client settings)
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/

# OAuth Scopes enabled on Cognito App Client (e.g. 'openid email')
VITE_COGNITO_SCOPE=openid email

# =============================================================
# AWS LAMBDA FUNCTION URL (Future Persistence & API)
# =============================================================
VITE_API_BASE_URL=https://example-function-url.lambda-url.ap-southeast-2.on.aws
VITE_API_TIMEOUT_MS=10000
